<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LIST VIEW -->
    <record id="view_isg_risk_assessment_list" model="ir.ui.view">
        <field name="name">isg.risk.assessment.list</field>
        <field name="model">isg.risk.assessment</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" readonly="1"/>
                <field name="workplace_id" readonly="1"/>
                <field name="assessment_date" readonly="1"/>
                <field name="assessment_type" readonly="1" widget="badge"/>
                <field name="total_hazards" readonly="1"/>
                <field name="critical_risks" readonly="1"/>
                <field name="average_risk_score" readonly="1"/>
                <field name="state" widget="badge" readonly="1"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_isg_risk_assessment_form" model="ir.ui.view">
        <field name="name">isg.risk.assessment.form</field>
        <field name="model">isg.risk.assessment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_complete_assessment" type="object" string="Değerlendirmeyi Tamamla" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve_assessment" type="object" string="Onayla" invisible="state != 'completed'"/>
                    <field name="state" widget="statusbar" options="{'clickable': False}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="sequence" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="workplace_id" invisible="state != 'draft'"/>
                            <field name="assessment_date"/>
                            <field name="assessment_type"/>
                            <field name="team_leader_id"/>
                        </group>
                        <group>
                            <field name="total_hazards" readonly="1"/>
                            <field name="critical_risks" readonly="1"/>
                            <field name="high_risks" readonly="1"/>
                            <field name="average_risk_score" readonly="1"/>
                            <field name="next_assessment_date" readonly="1"/>
                        </group>
                    </group>

                    <field name="team_member_ids" widget="many2many_tags"/>

                    <notebook>
                        <page string="Değerlendirme Satırları" name="assessment_lines">
                            <field name="assessment_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="hazard_id"/>
                                    <field name="probability"/>
                                    <field name="severity"/>
                                    <field name="risk_score" readonly="1"/>
                                    <field name="risk_level" widget="badge" readonly="1"/>
                                    <field name="residual_risk_score"/>
                                    <field name="residual_risk_level" widget="badge" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notlar" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_isg_risk_assessment_search" model="ir.ui.view">
        <field name="name">isg.risk.assessment.search</field>
        <field name="model">isg.risk.assessment</field>
        <field name="arch" type="xml">
            <search>
                <field name="sequence" string="Değerlendirme No"/>
                <field name="workplace_id" string="İşyeri"/>
                <field name="assessment_date" string="Tarih"/>
                <separator/>
                <filter name="draft" string="Taslak" domain="[('state', '=', 'draft')]"/>
                <filter name="completed" string="Tamamlandı" domain="[('state', '=', 'completed')]"/>
                <filter name="approved" string="Onaylı" domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter name="has_critical" string="Kritik Risk Var" domain="[('critical_risks', '>', 0)]"/>
                <filter name="high_risk" string="Yüksek Risk Var" domain="[('high_risks', '>', 0)]"/>
                <separator/>
                <filter name="initial" string="Ön Değerlendirme" domain="[('assessment_type', '=', 'initial')]"/>
                <filter name="periodic" string="Periyodik" domain="[('assessment_type', '=', 'periodic')]"/>
                <group string="Grupla" name="grouping">
                    <filter name="group_workplace" string="İşyeri" context="{'group_by': 'workplace_id'}"/>
                    <filter name="group_type" string="Türü" context="{'group_by': 'assessment_type'}"/>
                    <filter name="group_state" string="Durumu" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_isg_risk_assessment" model="ir.actions.act_window">
        <field name="name">Risk Değerlendirmeleri</field>
        <field name="res_model">isg.risk.assessment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Risk değerlendirmesi kaydı yok.</p>
            <p>İşyerinde risk değerlendirmesi yapın ve tehlikeleri tanımlayın.</p>
        </field>
    </record>

    <!-- MENU -->
    <menuitem
        id="menu_isg_risk"
        name="Risk Değerlendirmesi"
        parent="isg_core.menu_isg_root"
        sequence="30"
        action="action_isg_risk_assessment"/>

    <menuitem
        id="menu_isg_risk_hazard"
        name="Tehlike Kataloğu"
        parent="menu_isg_risk"
        sequence="20"
        action="action_isg_risk_hazard"/>

    <menuitem
        id="menu_isg_risk_matrix"
        name="Risk Matrisi"
        parent="menu_isg_risk"
        sequence="30"
        action="action_isg_risk_matrix"/>
</odoo>

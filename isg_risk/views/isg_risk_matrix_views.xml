<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LIST VIEW -->
    <record id="view_isg_risk_matrix_list" model="ir.ui.view">
        <field name="name">isg.risk.matrix.list</field>
        <field name="model">isg.risk.matrix</field>
        <field name="arch" type="xml">
            <list>
                <field name="probability" readonly="1"/>
                <field name="severity" readonly="1"/>
                <field name="risk_score" readonly="1"/>
                <field name="risk_level" widget="badge" readonly="1"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_isg_risk_matrix_form" model="ir.ui.view">
        <field name="name">isg.risk.matrix.form</field>
        <field name="model">isg.risk.matrix</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="probability" readonly="1"/>
                            <field name="severity" readonly="1"/>
                            <field name="risk_score" readonly="1"/>
                            <field name="risk_level" widget="badge" readonly="1"/>
                        </group>
                        <group>
                            <field name="color" readonly="1"/>
                        </group>
                    </group>
                    <field name="description" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_isg_risk_matrix_search" model="ir.ui.view">
        <field name="name">isg.risk.matrix.search</field>
        <field name="model">isg.risk.matrix</field>
        <field name="arch" type="xml">
            <search>
                <field name="probability" string="Olasılık"/>
                <field name="severity" string="Şiddet"/>
                <field name="risk_level" string="Risk Seviyesi"/>
                <separator/>
                <filter name="critical" string="Kritik" domain="[('risk_level', '=', 'critical')]"/>
                <filter name="high" string="Yüksek" domain="[('risk_level', '=', 'high')]"/>
                <filter name="medium" string="Orta" domain="[('risk_level', '=', 'medium')]"/>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_isg_risk_matrix" model="ir.actions.act_window">
        <field name="name">Risk Matrisi</field>
        <field name="res_model">isg.risk.matrix</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Risk matrisini tanımlayın.</p>
        </field>
    </record>
</odoo>

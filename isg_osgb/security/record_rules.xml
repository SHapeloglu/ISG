        <field name="name">OSGB Atama: Readonly (workplace/company)</field>
        <field name="model_id" ref="isg_osgb.model_isg_osgb_assignment"/>
        <field name="groups" eval="[(4, ref('isg_security.group_isg_readonly'))]"/>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- isg.osgb, isg.osgb.expert, isg.osgb.physician: OSGB'nin kendi master verisi
         (workplace kavramına bağlı değil, sadece company_id izolasyonu) -->
    <record id="isg_osgb_rule_readonly" model="ir.rule">
        <field name="name">OSGB: Readonly (company)</field>
        <field name="model_id" ref="isg_osgb.model_isg_osgb"/>
        <field name="groups" eval="[(4, ref('isg_security.group_isg_readonly'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="isg_osgb_rule_expert" model="ir.rule">
        <field name="name">OSGB: Expert (company)</field>

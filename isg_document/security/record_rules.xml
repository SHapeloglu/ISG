<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="isg_document_rule_readonly" model="ir.rule">
        <field name="name">Belge: Readonly (workplace/company)</field>
        <field name="model_id" ref="isg_document.model_isg_document"/>
        <field name="groups" eval="[(4, ref('isg_security.group_isg_readonly'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
        <field name="domain_force">['|', ('workplace_id', 'in', user.isg_workplace_ids.ids), '&amp;', ('workplace_id', '=', False), ('company_id', 'in', company_ids)] if user.isg_workplace_ids else [('company_id', 'in', company_ids)]</field>
    </record>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- isg.obligation List View -->
        <record id="isg_obligation_list" model="ir.ui.view">
            <field name="name">isg.obligation.list</field>
            <field name="model">isg.obligation</field>
            <field name="arch" type="xml">
                <list string="Yükümlülükler">
                    <field name="name"/>
                    <field name="legislation_id"/>
                    <field name="article"/>
                    <field name="evidence_type"/>
                    <field name="is_periodic"/>
                    <field name="periodic_days"/>
                    <field name="retention_days"/>
                </list>
            </field>
        </record>

        <!-- isg.obligation Form View -->
        <record id="isg_obligation_form" model="ir.ui.view">
            <field name="name">isg.obligation.form</field>
            <field name="model">isg.obligation</field>
            <field name="arch" type="xml">
                <form string="Yükümlülük">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="legislation_id"/>
                                <field name="article"/>
                            </group>
                            <group>
                                <field name="evidence_type"/>
                                <field name="is_periodic"/>
                                <field name="periodic_days" invisible="is_periodic == False"/>
                            </group>
                        </group>
                        <group>
                            <field name="retention_days"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                        <separator string="Uygulanabilirlik Kuralları"/>
                        <field name="applicability_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="danger_class"/>
                                <field name="min_employee"/>
                                <field name="max_employee"/>
                                <field name="sector_type"/>
                                <field name="nace_code"/>
                            </list>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- isg.obligation Search View -->
        <record id="isg_obligation_search" model="ir.ui.view">
            <field name="name">isg.obligation.search</field>
            <field name="model">isg.obligation</field>
            <field name="arch" type="xml">
                <search string="Yükümlülükler">
                    <field name="name"/>
                    <field name="legislation_id"/>
                    <field name="article"/>
                    <separator/>
                    <filter string="Periyodik" name="filter_periodic" domain="[('is_periodic', '=', True)]"/>
                    <filter string="Tek Seferlik" name="filter_non_periodic" domain="[('is_periodic', '=', False)]"/>
                </search>
            </field>
        </record>

        <!-- isg.obligation Action -->
        <record id="isg_obligation_action" model="ir.actions.act_window">
            <field name="name">Yükümlülükler</field>
            <field name="res_model">isg.obligation</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_isg_obligation_list" name="Yükümlülükler" parent="menu_isg_legislation" 
                  action="isg_obligation_action" sequence="20"/>

    </data>
</odoo>

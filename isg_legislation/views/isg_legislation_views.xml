<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- isg.legislation List View -->
        <record id="isg_legislation_list" model="ir.ui.view">
            <field name="name">isg.legislation.list</field>
            <field name="model">isg.legislation</field>
            <field name="arch" type="xml">
                <list string="Mevzuatlar">
                    <field name="name"/>
                    <field name="legislation_type"/>
                    <field name="number"/>
                    <field name="effective_date"/>
                    <field name="amendment_date"/>
                </list>
            </field>
        </record>

        <!-- isg.legislation Form View -->
        <record id="isg_legislation_form" model="ir.ui.view">
            <field name="name">isg.legislation.form</field>
            <field name="model">isg.legislation</field>
            <field name="arch" type="xml">
                <form string="Mevzuat">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="legislation_type"/>
                                <field name="number"/>
                            </group>
                            <group>
                                <field name="effective_date"/>
                                <field name="amendment_date"/>
                            </group>
                        </group>
                        <group>
                            <field name="source_url"/>
                        </group>
                        <group>
                            <field name="notes"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- isg.legislation Search View -->
        <record id="isg_legislation_search" model="ir.ui.view">
            <field name="name">isg.legislation.search</field>
            <field name="model">isg.legislation</field>
            <field name="arch" type="xml">
                <search string="Mevzuatlar">
                    <field name="name"/>
                    <field name="number"/>
                    <field name="legislation_type"/>
                    <separator/>
                    <filter string="Kanun" name="filter_law" domain="[('legislation_type', '=', 'law')]"/>
                    <filter string="Yönetmelik" name="filter_regulation" domain="[('legislation_type', '=', 'regulation')]"/>
                    <filter string="Tebliğ" name="filter_communique" domain="[('legislation_type', '=', 'communique')]"/>
                </search>
            </field>
        </record>

        <!-- isg.legislation Action -->
        <record id="isg_legislation_action" model="ir.actions.act_window">
            <field name="name">Mevzuatlar</field>
            <field name="res_model">isg.legislation</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_isg_legislation" name="Mevzuat" parent="isg_core.menu_isg_root" sequence="50"/>
        <menuitem id="menu_isg_legislation_list" name="Mevzuatlar" parent="menu_isg_legislation" 
                  action="isg_legislation_action" sequence="10"/>

    </data>
</odoo>

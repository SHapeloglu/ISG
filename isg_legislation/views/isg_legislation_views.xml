<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- LIST VIEW -->
        <record id="view_isg_legislation_list" model="ir.ui.view">
            <field name="name">isg.legislation.list</field>
            <field name="model">isg.legislation</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="regulation_type"/>
                    <field name="regulation_number"/>
                    <field name="effective_date"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_isg_legislation_form" model="ir.ui.view">
            <field name="name">isg.legislation.form</field>
            <field name="model">isg.legislation</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_activate" type="object" string="Aktif Et" invisible="state != 'draft'" class="btn-primary"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="regulation_type"/>
                            <field name="regulation_number"/>
                            <field name="effective_date"/>
                            <field name="last_amendment_date"/>
                        </group>
                        <group>
                            <field name="source_url"/>
                            <field name="company_id"/>
                        </group>
                        <field name="description" widget="html"/>
                        <notebook>
                            <page string="Yükümlülükler">
                                <field name="obligation_ids" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record id="view_isg_legislation_search" model="ir.ui.view">
            <field name="name">isg.legislation.search</field>
            <field name="model">isg.legislation</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="regulation_number"/>
                    <filter name="active" string="Aktif" domain="[('state', '=', 'active')]"/>
                    <filter name="draft" string="Taslak" domain="[('state', '=', 'draft')]"/>
                </search>
            </field>
        </record>

        <!-- ACTION: Legislation -->
        <record id="action_isg_legislation" model="ir.actions.act_window">
            <field name="name">Mevzuat</field>
            <field name="res_model">isg.legislation</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_isg_legislation_search"/>
        </record>

        <!-- ACTION: Obligation -->
        <record id="action_isg_obligation" model="ir.actions.act_window">
            <field name="name">Yükümlülükler</field>
            <field name="res_model">isg.obligation</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- MAIN MENU -->
        <menuitem id="menu_isg_legislation" 
                  parent="isg_core.menu_isg_root"
                  name="Mevzuat"
                  action="action_isg_legislation"
                  sequence="100"/>

        <!-- SUBMENU: Yükümlülükler -->
        <menuitem id="menu_isg_obligation" 
                  parent="menu_isg_legislation"
                  name="Yükümlülükler"
                  action="action_isg_obligation"
                  sequence="10"/>

    </data>
</odoo>

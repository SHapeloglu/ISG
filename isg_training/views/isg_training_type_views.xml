<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_isg_training_type_form" model="ir.ui.view">
        <field name="name">isg.training.type.form</field>
        <field name="model">isg.training.type</field>
        <field name="arch" type="xml">
            <form string="Eğitim Türü">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Eğitim türü adı..."/></h1>
                    </div>
                    <group>
                        <group string="Temel Bilgiler">
                            <field name="code"/>
                            <field name="training_category"/>
                            <field name="delivery_method"/>
                            <field name="min_duration_hours"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Tekrar Periyotları (Ay)">
                            <field name="period_low"/>
                            <field name="period_medium"/>
                            <field name="period_high"/>
                        </group>
                    </group>
                    <group string="Hedef Kitle">
                        <group>
                            <field name="target_all"/>
                            <field name="target_new_employee"/>
                            <field name="target_pregnant"/>
                        </group>
                        <group>
                            <field name="target_young"/>
                            <field name="target_disabled"/>
                        </group>
                    </group>
                    <group string="Açıklama">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_isg_training_type_list" model="ir.ui.view">
        <field name="name">isg.training.type.list</field>
        <field name="model">isg.training.type</field>
        <field name="arch" type="xml">
            <list string="Eğitim Türleri">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="training_category"/>
                <field name="delivery_method"/>
                <field name="min_duration_hours"/>
                <field name="period_low"/>
                <field name="period_medium"/>
                <field name="period_high"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_isg_training_type" model="ir.actions.act_window">
        <field name="name">Eğitim Türleri</field>
        <field name="res_model">isg.training.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

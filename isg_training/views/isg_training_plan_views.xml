<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_isg_training_plan_form" model="ir.ui.view">
        <field name="name">isg.training.plan.form</field>
        <field name="model">isg.training.plan</field>
        <field name="arch" type="xml">
            <form string="Eğitim Planı">
                <header>
                    <button name="action_approve" type="object" string="Onayla"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="İptal Et"
                            invisible="state not in ('draft','approved')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Plan adı..."/></h1>
                    </div>
                    <group>
                        <group string="Plan Bilgileri">
                            <field name="year"/>
                            <field name="workplace_id"/>
                            <field name="company_id"/>
                        </group>
                        <group string="Özet">
                            <field name="total_planned"/>
                            <field name="total_completed"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Eğitim Kalemleri">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="training_type_id"/>
                                    <field name="planned_date"/>
                                    <field name="planned_duration_hours"/>
                                    <field name="target_employee_count"/>
                                    <field name="trainer"/>
                                    <field name="state"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notlar">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_isg_training_plan_list" model="ir.ui.view">
        <field name="name">isg.training.plan.list</field>
        <field name="model">isg.training.plan</field>
        <field name="arch" type="xml">
            <list string="Eğitim Planları">
                <field name="name"/>
                <field name="year"/>
                <field name="workplace_id"/>
                <field name="total_planned"/>
                <field name="total_completed"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'approved'"
                       decoration-warning="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="action_isg_training_plan" model="ir.actions.act_window">
        <field name="name">Eğitim Planları</field>
        <field name="res_model">isg.training.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                İlk eğitim planını oluşturun
            </p>
        </field>
    </record>

</odoo>

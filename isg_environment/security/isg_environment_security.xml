<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- isg.waste.storage: Sadece kendi işyerinin verileri görülsün -->
        <record model="ir.rule" id="waste_storage_workplace_rule">
            <field name="name">Atık Depolama - İşyeri Erişim</field>
            <field name="model_id" ref="isg_environment.model_isg_waste_storage"/>
            <field name="domain_force">[('workplace_id.company_id', 'in', user.company_ids.ids)]</field>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- isg.waste.disposal: Sadece kendi işyerinin verileri -->
        <record model="ir.rule" id="waste_disposal_workplace_rule">
            <field name="name">Atık Bertaraf - İşyeri Erişim</field>
            <field name="model_id" ref="isg_environment.model_isg_waste_disposal"/>
            <field name="domain_force">[('workplace_id.company_id', 'in', user.company_ids.ids)]</field>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
    </data>
</odoo>

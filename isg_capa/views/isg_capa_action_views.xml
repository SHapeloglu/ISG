<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_isg_capa_action_list" model="ir.ui.view">
        <field name="name">isg.capa.action.list</field>
        <field name="model">isg.capa.action</field>
        <field name="arch" type="xml">
            <list string="DÖF Aksiyonları"
                decoration-danger="is_overdue == True"
                decoration-success="state == 'done'">
                <field name="capa_id"/>
                <field name="name"/>
                <field name="action_type"/>
                <field name="responsible_id"/>
                <field name="due_date"/>
                <field name="completion_date"/>
                <field name="is_overdue" widget="boolean_toggle"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'done'"
                    decoration-danger="state == 'cancelled'"
                    decoration-warning="state == 'open'"/>
            </list>
        </field>
    </record>

    <record id="action_isg_capa_action_open" model="ir.actions.act_window">
        <field name="name">Açık Aksiyonlar</field>
        <field name="res_model">isg.capa.action</field>
        <field name="view_mode">list</field>
        <field name="domain">[('state', '=', 'open')]</field>
    </record>
</odoo>

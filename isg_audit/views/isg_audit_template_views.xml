<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LIST VIEW -->
    <record id="view_isg_audit_template_list" model="ir.ui.view">
        <field name="name">isg.audit.template.list</field>
        <field name="model">isg.audit.template</field>
        <field name="arch" type="xml">
            <list string="Denetim Şablonları">
                <field name="name"/>
                <field name="audit_type"/>
                <field name="question_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_isg_audit_template_form" model="ir.ui.view">
        <field name="name">isg.audit.template.form</field>
        <field name="model">isg.audit.template</field>
        <field name="arch" type="xml">
            <form string="Denetim Şablonu">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="audit_type"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Kontrol Maddeleri">
                            <field name="question_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="question"/>
                                    <field name="category"/>
                                    <field name="legal_reference"/>
                                    <field name="weight" string="Ağırlık"/>
                                    <field name="is_critical" string="Kritik"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_isg_audit_template" model="ir.actions.act_window">
        <field name="name">Denetim Şablonları</field>
        <field name="res_model">isg.audit.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

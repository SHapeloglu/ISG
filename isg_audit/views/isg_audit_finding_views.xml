<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LIST VIEW -->
    <record id="view_isg_audit_finding_list" model="ir.ui.view">
        <field name="name">isg.audit.finding.list</field>
        <field name="model">isg.audit.finding</field>
        <field name="arch" type="xml">
            <list string="Denetim Bulguları"
                decoration-danger="state == 'open' and escalation_level >= 2"
                decoration-warning="state == 'open' and escalation_level == 1"
                decoration-success="state == 'closed'">
                <field name="name"/>
                <field name="audit_id"/>
                <field name="category"/>
                <field name="finding_type"/>
                <field name="repeat_count"/>
                <field name="escalation_level"/>
                <field name="responsible_person_id"/>
                <field name="target_completion_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- KANBAN VIEW -->
    <record id="view_isg_audit_finding_kanban" model="ir.ui.view">
        <field name="name">isg.audit.finding.kanban</field>
        <field name="model">isg.audit.finding</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <field name="name"/>
                <field name="finding_description"/>
                <field name="repeat_count"/>
                <field name="escalation_level"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card">
                            <div class="oe_kanban_card_header">
                                <strong><field name="name"/></strong>
                            </div>
                            <div class="oe_kanban_card_content">
                                <p><field name="finding_description"/></p>
                                <p>Kategori: <field name="category"/></p>
                                <p>Türü: <field name="finding_type"/></p>
                                <p t-if="record.repeat_count.raw_value > 0">
                                    <i>Tekrar: <field name="repeat_count"/> kez</i>
                                </p>
                            </div>
                            <div class="oe_kanban_card_footer">
                                <button type="object" name="action_create_capa" 
                                    class="btn btn-sm btn-warning" 
                                    t-if="!record.is_capa_created.raw_value">
                                    DÖF Oluştur
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_isg_audit_finding_form" model="ir.ui.view">
        <field name="name">isg.audit.finding.form</field>
        <field name="model">isg.audit.finding</field>
        <field name="arch" type="xml">
            <form string="Denetim Bulgusu">
                <header>
                    <button name="action_create_capa" string="DÖF Oluştur"
                        type="object" class="btn-warning"
                        invisible="is_capa_created or state == 'closed'"/>
                    <button name="action_mark_resolved" string="Çözüldü"
                        type="object" class="btn-info"
                        invisible="state != 'open'"/>
                    <button name="action_verify" string="Doğrulandı"
                        type="object" class="btn-success"
                        invisible="state != 'resolved'"/>
                    <button name="action_close" string="Kapat"
                        type="object" class="btn-success"
                        invisible="state not in ('resolved', 'verified')"/>
                    <button name="action_reopen" string="Tekrar Aç"
                        type="object" class="btn-secondary"
                        invisible="state == 'open'"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="open,in_review,resolved,verified,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Bulgu Bilgileri">
                            <field name="audit_id"/>
                            <field name="audit_line_id"/>
                            <field name="category"/>
                            <field name="finding_type"/>
                            <field name="question"/>
                        </group>
                        <group string="Tekrarlanan Bulgu">
                            <field name="repeat_count"/>
                            <field name="escalation_level" readonly="1"/>
                            <field name="previous_finding_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                    <group string="Açıklama">
                        <field name="finding_description" nolabel="1"/>
                    </group>
                    <group string="Kök Neden Analizi (Ön)">
                        <field name="root_cause" nolabel="1"/>
                    </group>
                    <group>
                        <group string="Sorumlu &amp; Aksiyon">
                            <field name="responsible_person_id"/>
                            <field name="target_completion_date"/>
                        </group>
                        <group string="DÖF">
                            <field name="capa_id" readonly="1"/>
                            <field name="is_capa_created" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="İşyeri Context">
                            <field name="workplace_id" readonly="1"/>
                            <field name="site_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Kanıt">
                            <group>
                                <field name="evidence_text" nolabel="1" colspan="2"/>
                            </group>
                            <group string="Kanıt Dosyaları">
                                <field name="evidence_attachment_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="file_size" readonly="1"/>
                                        <field name="create_date" readonly="1"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_isg_audit_finding_search" model="ir.ui.view">
        <field name="name">isg.audit.finding.search</field>
        <field name="model">isg.audit.finding</field>
        <field name="arch" type="xml">
            <search string="Denetim Bulgusu Ara">
                <field name="name"/>
                <field name="audit_id"/>
                <field name="category"/>
                <separator/>
                <filter string="Gözlem" name="observation"
                    domain="[('finding_type','=','observation')]"/>
                <filter string="Uygunsuzluk" name="non_conformity"
                    domain="[('finding_type','=','non_conformity')]"/>
                <filter string="Majör" name="major"
                    domain="[('finding_type','=','major')]"/>
                <filter string="Kritik" name="critical"
                    domain="[('finding_type','=','critical')]"/>
                <separator/>
                <filter string="Tekrarlanan Bulgu Var" name="repeated"
                    domain="[('repeat_count','greater_than',0)]"/>
                <filter string="Eskalasyon Gerekli (Level 2)" name="escalation"
                    domain="[('escalation_level','>=',2)]"/>
                <separator/>
                <filter string="Açık" name="open" domain="[('state','=','open')]"/>
                <filter string="İnceleniyor" name="in_review" domain="[('state','=','in_review')]"/>
                <filter string="Çözüldü" name="resolved" domain="[('state','=','resolved')]"/>
                <filter string="Doğrulandı" name="verified" domain="[('state','=','verified')]"/>
                <filter string="Kapalı" name="closed" domain="[('state','=','closed')]"/>
                <group expand="0" string="Grupla">
                    <filter string="Durum" name="group_state"
                        context="{'group_by': 'state'}"/>
                    <filter string="Kategori" name="group_category"
                        context="{'group_by': 'category'}"/>
                    <filter string="Bulgu Türü" name="group_type"
                        context="{'group_by': 'finding_type'}"/>
                    <filter string="Denetim" name="group_audit"
                        context="{'group_by': 'audit_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_isg_audit_finding" model="ir.actions.act_window">
        <field name="name">Denetim Bulguları</field>
        <field name="res_model">isg.audit.finding</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_isg_audit_finding_search"/>
        <field name="context">{}</field>
    </record>
</odoo>

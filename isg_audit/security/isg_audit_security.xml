<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- isg.audit Record Rules (workplace_id var) -->
    <record id="isg_audit_rule_readonly" model="ir.rule">
        <field name="name">Denetim: Readonly (workplace/company)</field>
        <field name="model_id" ref="isg_audit.model_isg_audit"/>
        <field name="groups" eval="[(4, ref('isg_security.group_isg_readonly'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
        <field name="domain_force">[('workplace_id', 'in', user.isg_workplace_ids.ids)] if user.isg_workplace_ids else [('company_id', 'in', company_ids)]</field>
    </record>


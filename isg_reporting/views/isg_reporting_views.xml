<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_isg_reporting_workhours_list" model="ir.ui.view">
        <field name="name">isg.reporting.workhours.list</field>
        <field name="model">isg.reporting.workhours</field>
        <field name="arch" type="xml">
            <list string="İSG KPI Dönemleri">
                <field name="workplace_id"/>
                <field name="period_display"/>
                <field name="total_worked_hours"/>
                <field name="recordable_incident_count"/>
                <field name="lost_work_days_total"/>
                <field name="trir"/>
                <field name="lwdr"/>
                <field name="near_miss_count"/>
            </list>
        </field>
    </record>

    <record id="view_isg_reporting_workhours_form" model="ir.ui.view">
        <field name="name">isg.reporting.workhours.form</field>
        <field name="model">isg.reporting.workhours</field>
        <field name="arch" type="xml">
            <form string="İSG KPI Dönemi">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="period_display" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Dönem Bilgisi">
                            <field name="workplace_id"/>
                            <field name="company_id" readonly="1"/>
                            <field name="period_date"/>
                            <field name="period_end_date" readonly="1"/>
                        </group>
                        <group string="Çalışma Verisi">
                            <field name="total_worked_hours"/>
                            <field name="employee_count_snapshot"/>
                        </group>
                    </group>
                    <group string="Hesaplanan KPI Göstergeleri">
                        <group>
                            <field name="recordable_incident_count" readonly="1"/>
                            <field name="lost_work_days_total" readonly="1"/>
                            <field name="near_miss_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="trir" readonly="1"/>
                            <field name="lwdr" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notlar">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_isg_reporting_workhours_search" model="ir.ui.view">
        <field name="name">isg.reporting.workhours.search</field>
        <field name="model">isg.reporting.workhours</field>
        <field name="arch" type="xml">
            <search string="İSG KPI Ara">
                <field name="workplace_id"/>
                <field name="period_display"/>
                <group expand="0" string="Grupla">
                    <filter string="İşyeri" name="group_workplace" context="{'group_by': 'workplace_id'}"/>
                    <filter string="Dönem" name="group_period" context="{'group_by': 'period_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_isg_reporting_workhours" model="ir.actions.act_window">
        <field name="name">İSG KPI / TRIR / LWDR</field>
        <field name="res_model">isg.reporting.workhours</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

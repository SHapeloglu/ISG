<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="isg_correspondence_rule_readonly" model="ir.rule">
        <field name="name">Yazışma: Readonly (workplace/company)</field>
        <field name="model_id" ref="isg_correspondence.model_isg_correspondence"/>
        <field name="groups" eval="[(4, ref('isg_security.group_isg_readonly'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
        <field name="domain_force">[('workplace_id', 'in', user.isg_workplace_ids.ids)] if user.isg_workplace_ids else [('workplace_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="isg_correspondence_rule_expert" model="ir.rule">
        <field name="name">Yazışma: Expert (workplace/company)</field>
        <field name="model_id" ref="isg_correspondence.model_isg_correspondence"/>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search View: Audit Log Filters (MUST come before Action) -->
    <record id="view_isg_employee_health_audit_search" model="ir.ui.view">
        <field name="name">isg.employee.health.audit.search</field>
        <field name="model">isg.employee.health.audit</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_health_id"/>
                <field name="accessed_by_id"/>
                <field name="action"/>
                <separator/>
                <filter name="filter_reads" string="Okuma" domain="[('action', '=', 'read')]"/>
                <filter name="filter_writes" string="Yazma" domain="[('action', '=', 'write')]"/>
                <filter name="filter_deletes" string="Silme" domain="[('action', '=', 'delete')]"/>
            </search>
        </field>
    </record>

    <!-- List View: Audit Log -->
    <record id="view_isg_employee_health_audit_list" model="ir.ui.view">
        <field name="name">isg.employee.health.audit.list</field>
        <field name="model">isg.employee.health.audit</field>
        <field name="arch" type="xml">
            <list>
                <field name="accessed_date"/>
                <field name="accessed_by_id"/>
                <field name="action"/>
                <field name="sensitive_field"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <!-- Form View: Audit Log Detail -->
    <record id="view_isg_employee_health_audit_form" model="ir.ui.view">
        <field name="name">isg.employee.health.audit.form</field>
        <field name="model">isg.employee.health.audit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="employee_health_id"/>
                        <field name="accessed_by_id"/>
                        <field name="accessed_date"/>
                    </group>
                    <group>
                        <field name="action"/>
                        <field name="sensitive_field"/>
                    </group>
                    <group string="Değişim Kaydı">
                        <field name="before_value"/>
                        <field name="after_value"/>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action: Open Audit Logs -->
    <record id="action_isg_employee_health_audit" model="ir.actions.act_window">
        <field name="name">Sağlık Muayenesi Denetim Günlüğü</field>
        <field name="res_model">isg.employee.health.audit</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="isg_health_basic.view_isg_employee_health_audit_search"/>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- isg.employee.health Record Rules (workplace/company, KVKK) -->
    <record id="isg_health_rule_readonly" model="ir.rule">
        <field name="name">isg.employee.health: Read-only (workplace/company)</field>
        <field name="model_id" ref="model_isg_employee_health"/>
        <field name="groups" eval="[(4, ref('isg_security.group_isg_readonly'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
        <field name="domain_force">[('workplace_id', 'in', user.isg_workplace_ids.ids)] if user.isg_workplace_ids else [('employee_id.company_id', 'in', company_ids)]</field>
    </record>


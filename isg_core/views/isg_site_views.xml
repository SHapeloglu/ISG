<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="isg_site_view_list" model="ir.ui.view">
        <field name="name">isg.site.view.list</field>
        <field name="model">isg.site</field>
        <field name="arch" type="xml">
            <list string="Fiziksel Siteler">
                <field name="name"/>
                <field name="workplace_id"/>
                <field name="company_id"/>
                <field name="parent_id"/>
                <field name="site_type"/>
                <field name="danger_class"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="isg_site_view_form" model="ir.ui.view">
        <field name="name">isg.site.view.form</field>
        <field name="model">isg.site</field>
        <field name="arch" type="xml">
            <form string="Fiziksel Site / Lokasyon">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Site / Lokasyon Adı"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Bağlı Olduğu">
                            <field name="workplace_id"/>
                            <field name="company_id"/>
                            <field name="parent_id"/>
                        </group>
                        <group string="Özellikler">
                            <field name="site_type"/>
                            <field name="danger_class"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Notlar">
                        <field name="note" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Alt Lokasyonlar">
                            <field name="child_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="site_type"/>
                                    <field name="danger_class"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_isg_site" model="ir.actions.act_window">
        <field name="name">Fiziksel Siteler</field>
        <field name="res_model">isg.site</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                İlk fiziksel siteyi oluşturun
            </p>
        </field>
    </record>

</odoo>

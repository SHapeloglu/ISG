<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LIST VIEW -->
    <record id="view_isg_incident_list" model="ir.ui.view">
        <field name="name">isg.incident.list</field>
        <field name="model">isg.incident</field>
        <field name="arch" type="xml">
            <list string="İş Kazaları / Ramak Kala"
                decoration-danger="incident_type == 'accident'"
                decoration-warning="incident_type == 'near_miss'">
                <field name="name"/>
                <field name="incident_type"/>
                <field name="incident_date"/>
                <field name="workplace_id"/>
                <field name="site_id"/>
                <field name="victim_id"/>
                <field name="injury_type"/>
                <field name="lost_work_days"/>
                <field name="sgk_notification_required"/>
                <field name="sgk_notification_done"/>
                <field name="capa_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_isg_incident_form" model="ir.ui.view">
        <field name="name">isg.incident.form</field>
        <field name="model">isg.incident</field>
        <field name="arch" type="xml">
            <form string="İş Kazası / Ramak Kala">
                <header>
                    <button name="action_start_investigation" string="Araştırmaya Al"
                        type="object" class="btn-primary"
                        invisible="state != 'draft'"/>
                    <button name="action_sgk_pending" string="SGK Bildirimi Gerekli"
                        type="object" class="btn-warning"
                        invisible="state != 'investigation' or incident_type != 'accident'"/>
                    <button name="action_close" string="Kapat"
                        type="object" class="btn-success"
                        invisible="state not in ('investigation', 'sgk_pending')"/>
                    <button name="action_reset_draft" string="Taslağa Al"
                        type="object"
                        invisible="state == 'closed'"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,investigation,sgk_pending,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Olay Bilgileri">
                            <field name="incident_type"/>
                            <field name="company_id"/>
                            <field name="workplace_id"/>
                            <field name="site_id"/>
                            <field name="incident_date"/>
                            <field name="incident_time"/>
                            <field name="location_description"/>
                        </group>
                        <group string="Etkilenen Kişi">
                            <field name="victim_id"/>
                            <field name="victim_job_title" readonly="1"/>
                            <field name="victim_tenure_days"/>
                            <field name="witness_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Olay Tanımı">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group>
                        <group string="Yaralanma Bilgileri">
                            <field name="injury_type"/>
                            <field name="body_part"/>
                            <field name="first_aid_given"/>
                            <field name="hospitalized"/>
                            <field name="lost_work_days"/>
                        </group>
                        <group string="SGK Bildirimi" invisible="incident_type != 'accident'">
                            <field name="sgk_notification_required" readonly="1"/>
                            <field name="sgk_notification_deadline" readonly="1"/>
                            <field name="sgk_notification_done"/>
                            <field name="sgk_notification_date"
                                invisible="not sgk_notification_done"/>
                            <field name="sgk_reference_no"
                                invisible="not sgk_notification_done"/>
                        </group>
                    </group>
                    <group string="Kök Neden ve Aksiyon">
                        <group>
                            <field name="immediate_cause"/>
                            <field name="root_cause"/>
                        </group>
                        <group>
                            <field name="capa_id" readonly="1"/>
                            <button name="action_create_capa"
                                string="DÖF Kaydı Oluştur"
                                type="object"
                                class="btn-warning"
                                invisible="capa_id != False"/>
                            <field name="document_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notlar">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_isg_incident_search" model="ir.ui.view">
        <field name="name">isg.incident.search</field>
        <field name="model">isg.incident</field>
        <field name="arch" type="xml">
            <search string="İş Kazası / Ramak Kala Ara">
                <field name="name"/>
                <field name="workplace_id"/>
                <field name="victim_id"/>
                <separator/>
                <filter string="İş Kazası" name="accident"
                    domain="[('incident_type','=','accident')]"/>
                <filter string="Ramak Kala" name="near_miss"
                    domain="[('incident_type','=','near_miss')]"/>
                <filter string="Meslek Hastalığı" name="occupational_disease"
                    domain="[('incident_type','=','occupational_disease')]"/>
                <separator/>
                <filter string="SGK Bildirimi Bekleyen" name="sgk_pending"
                    domain="[('sgk_notification_required','=',True),('sgk_notification_done','=',False)]"/>
                <filter string="DÖF Açılmamış" name="no_capa"
                    domain="[('capa_id','=',False)]"/>
                <separator/>
                <filter string="Taslak" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Araştırma" name="investigation" domain="[('state','=','investigation')]"/>
                <filter string="Kapalı" name="closed" domain="[('state','=','closed')]"/>
                <group expand="0" string="Grupla">
                    <filter string="Olay Türü" name="group_type"
                        context="{'group_by': 'incident_type'}"/>
                    <filter string="İşyeri" name="group_workplace"
                        context="{'group_by': 'workplace_id'}"/>
                    <filter string="Durum" name="group_state"
                        context="{'group_by': 'state'}"/>
                    <filter string="Ay" name="group_month"
                        context="{'group_by': 'incident_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_isg_incident" model="ir.actions.act_window">
        <field name="name">İş Kazaları / Ramak Kala</field>
        <field name="res_model">isg.incident</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_isg_incident_search"/>
        <field name="context">{}</field>
    </record>
</odoo>

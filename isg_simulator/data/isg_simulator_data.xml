<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Simülasyon Sequence: ISG-SIM-YYYY-NNNN -->
        <record id="seq_isg_simulator_run" model="ir.sequence">
            <field name="name">ISG Simülasyon Numarası</field>
            <field name="code">isg.simulator.run</field>
            <field name="prefix">ISG-SIM-%(y)s-</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>

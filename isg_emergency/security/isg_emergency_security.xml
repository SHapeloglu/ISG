<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="isg_emergency_plan_rule_company" model="ir.rule">
            <field name="name">Acil Durum Planı — Şirket Erişim Kuralı</field>
            <field name="model_id" ref="isg_emergency.model_isg_emergency_plan"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('isg_security.group_isg_readonly'))]"/>
        </record>
        <record id="isg_emergency_drill_rule_company" model="ir.rule">
            <field name="name">Tatbikat — Şirket Erişim Kuralı</field>
            <field name="model_id" ref="isg_emergency.model_isg_emergency_drill"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('isg_security.group_isg_readonly'))]"/>
        </record>
    </data>
</odoo>

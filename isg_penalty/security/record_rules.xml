<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- isg.penalty Record Rules (stored related workplace_id var) -->
    <!-- isg.penalty.tariff kasıtlı olarak hariç: ulusal mevzuat referans tablosu, workplace'e bağlı değil -->
    <record id="isg_penalty_rule_readonly" model="ir.rule">
        <field name="name">Ceza Kaydı: Readonly (workplace/company)</field>
        <field name="model_id" ref="isg_penalty.model_isg_penalty"/>
        <field name="groups" eval="[(4, ref('isg_security.group_isg_readonly'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
        <field name="domain_force">[('workplace_id', 'in', user.isg_workplace_ids.ids)] if user.isg_workplace_ids else [('workplace_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="isg_penalty_rule_expert" model="ir.rule">
        <field name="name">Ceza Kaydı: Expert (workplace/company)</field>
        <field name="model_id" ref="isg_penalty.model_isg_penalty"/>
        <field name="groups" eval="[(4, ref('isg_security.group_isg_expert'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
        <field name="domain_force">[('workplace_id', 'in', user.isg_workplace_ids.ids)] if user.isg_workplace_ids else [('workplace_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="isg_penalty_rule_manager" model="ir.rule">
        <field name="name">Ceza Kaydı: Manager (workplace/company)</field>
        <field name="model_id" ref="isg_penalty.model_isg_penalty"/>
        <field name="groups" eval="[(4, ref('isg_security.group_isg_manager'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>
        <field name="domain_force">[('workplace_id', 'in', user.isg_workplace_ids.ids)] if user.isg_workplace_ids else [('workplace_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>

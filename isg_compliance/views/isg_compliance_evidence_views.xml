<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- isg.compliance.evidence List View -->
        <record id="view_isg_compliance_evidence_list" model="ir.ui.view">
            <field name="name">isg.compliance.evidence.list</field>
            <field name="model">isg.compliance.evidence</field>
            <field name="arch" type="xml">
                <list string="Uygunluk Kanıtları">
                    <field name="obligation_id" />
                    <field name="workplace_id" />
                    <field name="evidence_type" />
                    <field name="valid_from" />
                    <field name="valid_until" />
                    <field name="is_valid" widget="boolean" />
                </list>
            </field>
        </record>

        <!-- isg.compliance.evidence Form View -->
        <record id="view_isg_compliance_evidence_form" model="ir.ui.view">
            <field name="name">isg.compliance.evidence.form</field>
            <field name="model">isg.compliance.evidence</field>
            <field name="arch" type="xml">
                <form string="Uygunluk Kanıtı">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="obligation_id" />
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="workplace_id" />
                                <field name="evidence_type" />
                                <field name="is_valid" readonly="1" />
                            </group>
                            <group>
                                <field name="valid_from" />
                                <field name="valid_until" />
                            </group>
                        </group>
                        <group>
                            <field name="document_id" />
                        </group>
                        <group>
                            <group>
                                <field name="source_model" />
                                <field name="source_res_id" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Notlar">
                                <field name="notes" nolabel="1" />
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- isg.compliance.evidence Search View -->
        <record id="view_isg_compliance_evidence_search" model="ir.ui.view">
            <field name="name">isg.compliance.evidence.search</field>
            <field name="model">isg.compliance.evidence</field>
            <field name="arch" type="xml">
                <search string="Uygunluk Kanıtları">
                    <field name="obligation_id" />
                    <field name="workplace_id" />
                    <field name="evidence_type" />
                    <separator />
                    <filter name="filter_valid" string="Geçerli" domain="[('is_valid', '=', True)]" />
                    <filter name="filter_invalid" string="Geçersiz" domain="[('is_valid', '=', False)]" />
                    <separator />
                    <group expand="0" string="Grupla">
                        <filter string="Yükümlülük" name="group_obligation" domain="[]" context="{'group_by': 'obligation_id'}" />
                        <filter string="İşyeri" name="group_workplace" domain="[]" context="{'group_by': 'workplace_id'}" />
                        <filter string="Kanıt Türü" name="group_type" domain="[]" context="{'group_by': 'evidence_type'}" />
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_isg_compliance_evidence" model="ir.actions.act_window">
            <field name="name">Uygunluk Kanıtları</field>
            <field name="res_model">isg.compliance.evidence</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_isg_compliance_evidence" name="Kanıt Kaydı" parent="isg_legislation.menu_isg_legislation" action="action_isg_compliance_evidence" sequence="20" />

    </data>
</odoo>

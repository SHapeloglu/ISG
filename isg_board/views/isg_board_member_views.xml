<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_isg_board_member_list" model="ir.ui.view">
        <field name="name">isg.board.member.list</field>
        <field name="model">isg.board.member</field>
        <field name="arch" type="xml">
            <list string="Kurul Üyeleri">
                <field name="workplace_id"/>
                <field name="name"/>
                <field name="role"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_isg_board_member_form" model="ir.ui.view">
        <field name="name">isg.board.member.form</field>
        <field name="model">isg.board.member</field>
        <field name="arch" type="xml">
            <form string="Kurul Üyesi">
                <sheet>
                    <group>
                        <group>
                            <field name="workplace_id"/>
                            <field name="employee_id"/>
                            <field name="role"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notlar..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_isg_board_member" model="ir.actions.act_window">
        <field name="name">Kurul Üyeleri</field>
        <field name="res_model">isg.board.member</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="isg_ppe_issue_rule_company" model="ir.rule">
            <field name="name">KKD Zimmet — Şirket Erişim Kuralı</field>
            <field name="model_id" ref="isg_ppe.model_isg_ppe_issue"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('isg_security.group_isg_readonly'))]"/>
        </record>
        <record id="isg_ppe_stock_rule_company" model="ir.rule">
            <field name="name">KKD Stok — Şirket Erişim Kuralı</field>
            <field name="model_id" ref="isg_ppe.model_isg_ppe_stock"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('isg_security.group_isg_readonly'))]"/>
        </record>
    </data>
</odoo>

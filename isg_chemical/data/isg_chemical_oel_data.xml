<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Türkiye ÇSGB OEL/STEL Limitleri (2025 Referans) -->
    <!-- NOT: Tam doğruluk için ÇSGB Yönetmeliği'ne başvurulmalıdır -->
    
    <!-- Örnek: Su (H2O) — No limit (yaygın solvent) -->
    <record id="oel_water" model="isg.chemical.oel">
        <field name="chemical_id" search="[('cas_number', '=', '7732-18-5')]"/>
        <field name="twa_value">0</field>
        <field name="twa_unit">mg_m3</field>
        <field name="regulation_reference">ÇSGB İSG Yönetmeliği (2025)</field>
        <field name="notes">Su — Endüstriyel çözücü, limit yoktur</field>
    </record>

    <!-- Örnek: Asetone (C3H6O) — TWA: 750 ppm / 1800 mg/m³ -->
    <record id="oel_acetone" model="isg.chemical.oel">
        <field name="chemical_id" search="[('cas_number', '=', '67-64-1')]"/>
        <field name="twa_value">750</field>
        <field name="twa_unit">ppm</field>
        <field name="stel_value">1000</field>
        <field name="stel_unit">ppm</field>
        <field name="regulation_reference">ÇSGB İSG Yönetmeliği Ek-II (2025)</field>
        <field name="notes">Asetone (Propanon) — Çok yaygın solvent, toleranslı</field>
    </record>

    <!-- Örnek: Benzene (C6H6) — TWA: 1 ppm / 3.2 mg/m³ (Kanserojenik) -->
    <record id="oel_benzene" model="isg.chemical.oel">
        <field name="chemical_id" search="[('cas_number', '=', '71-43-2')]"/>
        <field name="twa_value">1</field>
        <field name="twa_unit">ppm</field>
        <field name="regulation_reference">ÇSGB İSG Yönetmeliği Ek-II (2025)</field>
        <field name="notes">Benzene — Kanserojenik, çok katı limit</field>
    </record>

    <!-- Örnek: Toluene (C7H8) — TWA: 50 ppm / 375 mg/m³ -->
    <record id="oel_toluene" model="isg.chemical.oel">
        <field name="chemical_id" search="[('cas_number', '=', '108-88-3')]"/>
        <field name="twa_value">50</field>
        <field name="twa_unit">ppm</field>
        <field name="stel_value">100</field>
        <field name="stel_unit">ppm</field>
        <field name="regulation_reference">ÇSGB İSG Yönetmeliği Ek-II (2025)</field>
        <field name="notes">Toluene (Metilbenzene) — Endüstriyel solvent</field>
    </record>

    <!-- Örnek: Formaldehyde (CH2O) — TWA: 0.3 ppm / 0.37 mg/m³ (Kanserojenik) -->
    <record id="oel_formaldehyde" model="isg.chemical.oel">
        <field name="chemical_id" search="[('cas_number', '=', '50-00-0')]"/>
        <field name="twa_value">0.3</field>
        <field name="twa_unit">ppm</field>
        <field name="stel_value">0.6</field>
        <field name="stel_unit">ppm</field>
        <field name="regulation_reference">ÇSGB İSG Yönetmeliği Ek-II (2025)</field>
        <field name="notes">Formaldehyde — Kanserojenik, açık proseslerle kullanım sınırlı</field>
    </record>

    <!-- Not: Bu dosya şablon niteliğindedir. Gerçek OEL/STEL değerleri ÇSGB tarafından onaylanmalıdır. -->
</odoo>

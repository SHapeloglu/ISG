<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Incompatibility List View -->
    <record id="view_isg_chemical_incompatibility_list" model="ir.ui.view">
        <field name="name">isg.chemical.incompatibility.list</field>
        <field name="model">isg.chemical.incompatibility</field>
        <field name="arch" type="xml">
            <list string="Depolama Uyumsuzlukları"
                decoration-danger="severity == 'critical'"
                decoration-warning="severity == 'high'">
                <field name="chemical_id_a"/>
                <field name="chemical_id_b"/>
                <field name="severity" widget="badge"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <!-- Incompatibility Form View -->
    <record id="view_isg_chemical_incompatibility_form" model="ir.ui.view">
        <field name="name">isg.chemical.incompatibility.form</field>
        <field name="model">isg.chemical.incompatibility</field>
        <field name="arch" type="xml">
            <form string="Uyumsuzluk Kaydı">
                <sheet>
                    <group>
                        <field name="chemical_id_a"/>
                        <field name="chemical_id_b"/>
                        <field name="severity" widget="badge"/>
                    </group>
                    <group string="Neden">
                        <field name="reason" nolabel="1"/>
                    </group>
                    <group string="Hafifletme Önlemleri">
                        <field name="mitigation_measures" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_isg_chemical_incompatibility" model="ir.actions.act_window">
        <field name="name">Depolama Uyumsuzlukları</field>
        <field name="res_model">isg.chemical.incompatibility</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
